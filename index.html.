/* NUTRIA — visual language inspired by the supplied reference */
:root{
 --bg:#111213;--panel:#1a1b1d;--panel2:#202225;--line:#333538;
 --text:#f3f4f5;--muted:#96999d;--lime:#42d88b;--blue:#3979f6;
 --orange:#ffb86b;--pink:#f28ca7;--glow:rgba(65,216,139,.12);
}
html{background:#111213;color-scheme:dark;scroll-behavior:smooth}
body{
 color:var(--text);
 background:radial-gradient(ellipse at 50% 0%,#202123 0%,#151617 40%,#111213 100%);
 letter-spacing:-.012em;
}
.app{max-width:700px;padding:22px 16px 36px}
.top{margin-bottom:28px}
.brand{font-size:16px;letter-spacing:.23em;font-weight:800}
.brand span{color:var(--lime)}
.date{font-size:11px;text-transform:capitalize;letter-spacing:.08em;color:#a7a9ac;margin-top:6px}
.avatar{width:42px;height:42px;border-radius:50%;background:#222427;border:1px solid #414347;box-shadow:inset 0 1px #ffffff0b}
h1{font-size:30px;line-height:1.1;letter-spacing:-.05em;font-weight:750;margin-bottom:9px}
h2{font-size:15px;letter-spacing:-.02em}
.sub{font-size:12px;line-height:1.6;max-width:420px;color:var(--muted)}
.panel{
 position:relative;background:linear-gradient(145deg,#202123,#191a1c);
 border:1px solid #343639;border-radius:27px;padding:19px;
 box-shadow:0 18px 45px #0002,inset 0 1px #ffffff05;
 margin-top:15px
}
.hero{
 grid-template-columns:1fr 132px;gap:8px;min-height:196px;overflow:visible;
 border-color:#393b3e;
 background:linear-gradient(145deg,#202123,#191a1c);
}
.hero:before{
 content:"";position:absolute;inset:-8px;border-radius:33px;pointer-events:none;
 border:1px solid transparent;
 background:linear-gradient(135deg,transparent 0 55%,#f2f3f4 55.5% 56.2%,transparent 56.7% 100%) border-box;
 mask:linear-gradient(#000 0 0) padding-box,linear-gradient(#000 0 0);
 mask-composite:exclude;opacity:.7
}
.eyebrow{font-size:10px;letter-spacing:.16em;color:#a8aaad;text-transform:uppercase}
.big{font-size:39px;letter-spacing:-.065em;margin:11px 0 4px;font-weight:800}
.big small{font-size:13px;color:#9a9ca0;font-weight:500;letter-spacing:-.02em}
.pill{border:1px solid #287d57;color:#56e39d;background:#173528;padding:7px 11px;font-size:10px;letter-spacing:.08em}
.ring{width:126px;height:126px}
.ring circle{stroke-width:7}
.ring .track{stroke:#35373a}
.ring .progress{filter:drop-shadow(0 0 4px #42d88b35)}
.ringtext strong{font-size:24px;letter-spacing:-.05em}
.ringtext span{font-size:10px;letter-spacing:.04em;color:#a7a9ac}
.sectionhead{margin-bottom:16px}
.textbtn{color:#68a0ff;font-size:11px}
.macros{gap:9px}
.macro{background:linear-gradient(145deg,#232528,#1b1c1f);border:1px solid #343639;border-radius:18px;padding:13px 12px}
.macrohead{font-size:11px;color:#c3c5c8}
.macro strong{font-size:21px;letter-spacing:-.04em;margin:12px 0 10px}
.macro small{font-size:10px;color:#a0a2a5}
.bar{height:4px;background:#3b3d41;border-radius:20px}
.bar span{box-shadow:0 0 9px #3979f62e}
.quick{gap:10px;margin-top:13px}
.action{
 position:relative;overflow:hidden;padding:16px 14px;border-radius:19px;text-align:left;
 background:linear-gradient(145deg,#232528,#1b1c1f);border:1px solid #393b3e;
 transition:transform .18s,border-color .18s
}
.action:active{transform:scale(.985)}
.action.primary{
 background:linear-gradient(135deg,#3979f6,#2d68e0);color:#fff;border-color:#548bff;
 box-shadow:0 8px 24px #3979f61c
}
.action .ico{font-size:22px;margin-bottom:15px}
.action strong{font-size:13px;letter-spacing:-.02em}
.action span:last-child{font-size:10px;line-height:1.4;margin-top:5px;color:inherit;opacity:.75}
.meal{gap:11px;padding:13px 0}
.foodicon{width:44px;height:44px;flex:0 0 44px;border-radius:15px;background:linear-gradient(145deg,#292b2f,#202225);border:1px solid #3a3c40;font-size:19px}
.foodinfo strong{font-size:12px;letter-spacing:-.015em}
.foodinfo span{font-size:10px;line-height:1.5;display:block;margin-top:4px;color:#a3a5a8}
.kcal{font-size:13px;letter-spacing:-.02em}
.delete{border-radius:9px}
.nav{
 background:rgba(18,19,20,.91);backdrop-filter:blur(24px);
 border-top:1px solid #333538;padding:9px 9px calc(9px + env(safe-area-inset-bottom))
}
.navin{gap:7px}
.nav button{border-radius:15px;padding:9px 3px;font-size:10px;transition:background .2s,color .2s;color:#a2a4a7}
.nav button b{font-size:17px;margin-bottom:5px}
.nav button.active{background:#242629;color:#f4f5f6;box-shadow:inset 0 0 0 1px #414347}
.field{gap:8px;margin:14px 0}
.field label{font-size:11px;letter-spacing:.02em;color:#c4c6c9}
.field input,.field select{
 background:#17181a;border:1px solid #3a3c40;border-radius:14px;padding:13px 14px;
 transition:border-color .2s,box-shadow .2s
}
.field input:focus,.field select:focus{border-color:#3979f6;box-shadow:0 0 0 3px #3979f61a}
.primarybtn{background:linear-gradient(135deg,#3979f6,#2d68e0);color:#fff;border-radius:15px;padding:14px 16px;font-size:13px;box-shadow:0 8px 22px #3979f61a}
.secondarybtn{background:#242629;border:1px solid #3a3c40;border-radius:14px}
.foodresult{padding:14px 0}
.foodresult strong{font-size:12px}
.foodresult small{font-size:10px;line-height:1.5;color:#a5a7aa}
.foodresult button{border-radius:12px;background:#252a32;border-color:#3c4d70;padding:9px 12px;font-size:11px;color:#a8c6ff}
.notice{background:#1b2b24;border:1px solid #2e5742;color:#c3f2d8;border-radius:15px;font-size:11px;line-height:1.55}
.empty{font-size:12px;line-height:1.6;color:#a5a7aa}
#modal{backdrop-filter:blur(9px)}
@media(max-width:420px){
 .app{padding:18px 13px 28px}
 h1{font-size:29px}
 .hero{grid-template-columns:1fr 105px;min-height:184px;padding:16px 14px}
 .ring{width:102px;height:102px}
 .big{font-size:33px}
 .panel{padding:15px;border-radius:23px}
 .macro{padding:11px 9px;border-radius:15px}
 .macro strong{font-size:18px}
 .macrohead{font-size:10px}
 .action{padding:15px 12px}
}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}}


.steps-panel{background:linear-gradient(145deg,#202123,#191a1c);border-color:#343639}
.steps-tag{font-size:9px;letter-spacing:.14em;color:#a5a7aa}
.steps-layout{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:5px 0 12px}
.steps-number{display:flex;align-items:baseline;gap:8px;flex-wrap:wrap}
.steps-number span{font-size:43px;font-weight:800;letter-spacing:-.065em}
.steps-number small{font-size:12px;color:#9b9da0}
.steps-ring{width:92px;height:92px;position:relative;flex:0 0 92px}
.steps-ring svg{width:100%;height:100%;transform:rotate(-90deg)}
.steps-ring circle{fill:none;stroke-width:6}
.steps-track{stroke:#37393c}
.steps-progress{stroke:#42d88b;stroke-linecap:round;stroke-dasharray:251.33;stroke-dashoffset:251.33;filter:drop-shadow(0 0 4px #42d88b33)}
.steps-ring-text{position:absolute;inset:0;display:grid;place-items:center}
.steps-ring-text strong{font-size:16px}
.steps-meta{display:flex;align-items:center;justify-content:space-between;font-size:11px;color:#a5a7aa;margin:2px 0 9px}
.steps-meta strong{color:#f1f2f3;font-size:11px}
.steps-bar{height:5px;background:#37393c;border-radius:20px;overflow:hidden}
.steps-bar span{height:100%;display:block;width:0;background:linear-gradient(90deg,#42d88b,#79edb1);border-radius:20px;transition:width .2s}
.steps-controls{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:15px}
.steps-controls button{font-size:12px;padding:13px;border-radius:12px;font-weight:800}.steps-controls .start{background:var(--lime);color:#11140b}.steps-controls .pause{background:var(--panel2);border:1px solid var(--line);color:var(--text)}.steps-controls button:disabled{opacity:.45;cursor:not--allowed}
.steps-note{font-size:10px;line-height:1.5;color:#8f9296;margin-top:11px}


/* Refinamiento del encabezado principal */
.dashboard-intro{margin:27px 0 25px;position:relative}
.intro-kicker{font-size:10px;font-weight:700;letter-spacing:.19em;color:#8f9296;margin-bottom:10px}
.dashboard-intro h1{font-size:29px;line-height:1.12;letter-spacing:-.045em;font-weight:750;margin:0 0 9px;white-space:normal}
.title-accent{color:#42d88b}
.dashboard-intro .sub{margin:0;color:#a1a3a6;font-size:12px;line-height:1.55}
@media(max-width:420px){.dashboard-intro{margin:25px 0 23px}.dashboard-intro h1{font-size:28px}}


/* El encabezado del dashboard queda vacío: se conserva el espacio limpio */
.dashboard-intro{display:none!important}


/* Diario: jerarquía visual y resumen nutricional */
.diary-heading{margin:8px 0 18px}
.diary-kicker{font-size:9px;letter-spacing:.19em;font-weight:750;color:#92969a;margin-bottom:8px}
.diary-title-row{display:flex;align-items:center;justify-content:space-between}
.diary-title-row h1{font-size:28px;letter-spacing:-.045em;margin:0 0 6px}
.diary-date{font-size:10px;color:#a4a7aa;border:1px solid #3a3d40;border-radius:20px;padding:6px 10px;text-transform:capitalize}
.diary-heading .sub{font-size:12px}
.diary-summary{background:linear-gradient(145deg,#202225,#191a1c);border-color:#3a3d40}
.diary-kcal{font-size:30px;font-weight:800;letter-spacing:-.055em;margin-top:5px}
.diary-summary-icon{width:38px;height:38px;display:grid;place-items:center;border-radius:13px;background:#24282d;color:#69a0ff;font-size:20px;border:1px solid #3a414b}
.diary-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-top:17px;padding-top:14px;border-top:1px solid #36383b}
.diary-stats div{display:flex;flex-direction:column;gap:5px}
.diary-stats span{font-size:10px;color:#999da1}
.diary-stats strong{font-size:15px;letter-spacing:-.025em}
.diary-count{font-size:10px;color:#9da1a5}
.diary-empty{display:flex;flex-direction:column;align-items:center;text-align:center;padding:26px 12px 20px;gap:7px}
.diary-empty span{width:42px;height:42px;display:grid;place-items:center;border-radius:14px;background:#202b26;color:#42d88b;font-size:23px;margin-bottom:4px}
.diary-empty strong{font-size:12px}
.diary-empty small{font-size:10px;color:#92969a;line-height:1.5;max-width:220px}
#diaryMeals .meal{padding:14px 0}
#diaryMeals .foodicon{border:1px solid #383b3f;background:linear-gradient(145deg,#292c30,#202225)}
#history .meal{padding:13px 0}
@media(max-width:420px){.diary-kcal{font-size:28px}.diary-stats strong{font-size:14px}}


.training-note{font-size:11px;line-height:1.5;color:#96999d;margin-top:10px}
.training-result{display:flex;align-items:center;justify-content:space-between;padding:13px 0;border-bottom:1px solid var(--line);gap:12px}
.training-result:last-child{border-bottom:0}
.training-result strong{font-size:13px}.training-result small{display:block;color:var(--muted);font-size:11px;margin-top:4px}
.training-kcal{font-size:15px;font-weight:800;text-align:right;white-space:nowrap}.training-kcal small{font-size:10px;font-weight:500}
.training-form-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
@media(max-width:420px){.training-form-grid{grid-template-columns:1fr 1fr}}

/* Balance energético: jerarquía visual clara y lectura rápida */
.calorie-dashboard{padding:19px;background:linear-gradient(145deg,#202326,#17191b);border-color:#383d40;overflow:hidden}
.calorie-top{display:flex;justify-content:space-between;align-items:center;gap:8px}
.calorie-left{display:flex;align-items:baseline;gap:8px;margin:12px 0 3px;flex-wrap:wrap}
.calorie-left strong{font-size:38px;line-height:1;font-weight:850;letter-spacing:-.065em;color:#f4f6f5}
.calorie-left span{font-size:12px;color:#a7adb0}
.calorie-status{font-size:11px;color:#9ba3a5;margin-top:7px}
.calorie-dashboard .ring{flex:0 0 116px;width:116px;height:116px}
.calorie-dashboard .ringtext strong{font-size:22px}
.calorie-meter{height:9px;background:#343a3c;border-radius:20px;overflow:hidden;margin:18px 0 15px}
.calorie-meter span{display:block;height:100%;width:0;border-radius:20px;background:linear-gradient(90deg,#42d88b,#b5f36a);transition:width .3s}
.calorie-breakdown{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;padding-bottom:15px;border-bottom:1px solid #34383a}
