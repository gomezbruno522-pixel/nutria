.calorie-breakdown strong{grid-column:2;font-size:13px;margin-top:4px;white-space:nowrap}
.legend-dot{width:7px;height:7px;border-radius:50%;grid-row:span 2}.legend-dot.eaten{background:#42d88b}.legend-dot.target{background:#7e8a92}.legend-dot.exercise{background:#70aaff}
