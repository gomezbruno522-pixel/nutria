}

function currentSteps(){return Math.max(0,Math.floor(Number(state.stepsByDate[todayKey()]||0)))}
function renderSteps(){
 const count=currentSteps(),goal=Math.max(1,Number(state.stepGoal)||10000),pct=Math.min(100,Math.round(count/goal*100));
 const countEl=document.getElementById("stepsCount");if(!countEl)return;
 countEl.textContent=fmt(count);
 document.getElementById("stepsPercent").textContent=pct+"%";
 document.getElementById("stepsGoalLabel").textContent=fmt(goal)+" pasos";
 document.getElementById("stepsRing").style.strokeDashoffset=251.33-(251.33*pct/100);
 document.getElementById("stepsBar").style.width=pct+"%";
 const kcalEl=document.getElementById("stepsCalories");if(kcalEl)kcalEl.textContent=fmt(estimateStepsKcal(count))+" kcal";
 const active=!!state.stepsTracking;
 const start=document.getElementById("stepsStart"),pause=document.getElementById("stepsPause");
 if(start)start.disabled=active;if(pause)pause.disabled=!active;
 if(start)start.textContent=active?"✓ Contando":"▶ Iniciar";
}
function setSteps(count,shouldRender=true){
 state.stepsByDate=state.stepsByDate||{};
 state.stepsByDate[todayKey()]=Math.max(0,Math.floor(count||0));
 localStorage.setItem("nutria-v1",JSON.stringify(state));
 if(shouldRender){renderSteps();renderDashboard()}
}
let motionHandler=null,lastMotionStep=0,motionBaseline=null;
function setStepStatus(message){const el=document.getElementById("stepsStatus");if(el)el.textContent=message}
function stopMotionFallback(){if(motionHandler){window.removeEventListener("devicemotion",motionHandler);motionHandler=null}}
function startMotionFallback(){
 if(!('DeviceMotionEvent' in window))return false;
 motionBaseline=null;lastMotionStep=0;
 motionHandler=(event)=>{
   if(!state.stepsTracking||document.hidden)return;
   const a=event.accelerationIncludingGravity||event.acceleration;
   if(!a||a.x==null||a.y==null||a.z==null)return;
   const magnitude=Math.sqrt(a.x*a.x+a.y*a.y+a.z*a.z);
   if(!Number.isFinite(magnitude))return;
   motionBaseline=motionBaseline==null?magnitude:motionBaseline*.88+magnitude*.12;
   const impulse=Math.abs(magnitude-motionBaseline);
   const now=Date.now();
   // Approximate foreground-only step detection. Android native sensor is preferred.
   if(impulse>1.25&&now-lastMotionStep>320){lastMotionStep=now;setSteps(currentSteps()+1,false);renderSteps();renderDashboard()}
 };
 window.addEventListener("devicemotion",motionHandler,{passive:true});
 return true;
}
async function startStepCounting(){
 if(state.stepsTracking)return;
 try{
   if(window.AndroidSteps&&typeof window.AndroidSteps.startTracking==="function"){
     const result=window.AndroidSteps.startTracking();
     if(result&&typeof result.then==="function")await result;
     state.stepsTracking=true;localStorage.setItem("nutria-v1",JSON.stringify(state));
     setStepStatus("Conteo iniciado con el sensor Android. Puede continuar con la pantalla apagada si la aplicación Android mantiene activo el servicio de pasos.");
   }else{
     if(typeof DeviceMotionEvent!=="undefined"&&typeof DeviceMotionEvent.requestPermission==="function"){
       const permission=await DeviceMotionEvent.requestPermission();
       if(permission!=="granted")throw new Error("No se concedió permiso al sensor de movimiento.");
     }
     const started=startMotionFallback();
     if(!started)throw new Error("Este dispositivo no ofrece un sensor de movimiento compatible en el navegador.");
     state.stepsTracking=true;localStorage.setItem("nutria-v1",JSON.stringify(state));
     setStepStatus("Conteo iniciado en modo navegador. Para seguir contando con la pantalla apagada o NUTRIA cerrada hace falta la integración nativa de Android.");
   }
   renderSteps();
 }catch(error){state.stepsTracking=false;stopMotionFallback();renderSteps();setStepStatus(error&&error.message?error.message:"No se pudo iniciar el contador. Revisá los permisos del sensor.")}
}
async function pauseStepCounting(){
 if(!state.stepsTracking)return;
 try{
   if(window.AndroidSteps&&typeof window.AndroidSteps.pauseTracking==="function"){
     const result=window.AndroidSteps.pauseTracking();if(result&&typeof result.then==="function")await result;
   }
 }catch(e){}
 stopMotionFallback();state.stepsTracking=false;localStorage.setItem("nutria-v1",JSON.stringify(state));
 setStepStatus("Conteo pausado. Tus pasos quedaron guardados; podés reanudar cuando quieras.");renderSteps();renderDashboard();
}
document.getElementById("stepsStart")?.addEventListener("click",startStepCounting);
document.getElementById("stepsPause")?.addEventListener("click",pauseStepCounting);
function updateNativeSteps(){
 try{
   if(state.stepsTracking&&window.AndroidSteps&&typeof window.AndroidSteps.getTodaySteps==="function"){
     const n=Math.max(0,Number(window.AndroidSteps.getTodaySteps())||0);
     state.stepsByDate=state.stepsByDate||{};state.stepsByDate[todayKey()]=n;
     try{localStorage.setItem("nutria-v1",JSON.stringify(state))}catch(e){}
     renderSteps();renderDashboard();
   }
 }catch(e){}
}
if(state.stepsTracking){
 if(window.AndroidSteps&&typeof window.AndroidSteps.startTracking==="function"){
   try{window.AndroidSteps.startTracking();setStepStatus("Retomando el conteo con el servicio Android…")}catch(e){state.stepsTracking=false}
 }else{
   state.stepsTracking=false;localStorage.setItem("nutria-v1",JSON.stringify(state));
   setStepStatus("El conteo anterior quedó pausado al reabrir el navegador. Para continuar con pantalla apagada necesitás la integración nativa Android.");
 }
}
renderSteps();
setInterval(updateNativeSteps,5000);
document.addEventListener("visibilitychange",()=>{if(!document.hidden)updateNativeSteps()});

const activityMET={gym:3.5,hiit:8,run:9.8,walk:3.8,boxing:7.8,bike:7.5,swim:7,football:7,basketball:6.5,tennis:7.3};
const activityNames={gym:"Gimnasio / musculación",hiit:"HIIT",run:"Correr",walk:"Caminar",boxing:"Boxeo",bike:"Bicicleta",swim:"Natación",football:"Fútbol",basketball:"Básquet",tennis:"Tenis"};
function latestWeight(){const ws=(state.weights||[]).slice().sort((a,b)=>b.date.localeCompare(a.date));return ws.length?Number(ws[0].kg):null}
function estimateTraining(){const minutes=Math.max(0,Number(trainingMinutes.value)||0),weight=Number(latestWeight()||state.profile.weight||0),met=activityMET[trainingType.value]||5,factor=Number(trainingIntensity.value)||1;if(!minutes)return null;if(!(weight>0))return null;return Math.round((Math.max(0,met*factor-1)*3.5*weight/200)*minutes)}
function updateTrainingEstimate(){const el=document.getElementById("trainingEstimate"),minutes=Number(trainingMinutes.value)||0,weight=latestWeight();if(!minutes){el.textContent="Completá la duración para ver una estimación.";return}if(!weight){el.textContent="Registrá tu peso en Perfil para calcular las calorías estimadas.";return}el.textContent=`Calorías activas estimadas: ${fmt(estimateTraining())} kcal · se descuenta el gasto de reposo.`}
function trainingRow(t,withDelete=true){return `<div class="training-result"><div><strong>${esc(t.name)}</strong><small>${t.minutes} min · ${esc(t.intensity)} · ${new Date(t.date+"T12:00:00").toLocaleDateString("es-AR",{day:"numeric",month:"short"})}</small></div><div class="training-kcal">${fmt(t.kcal)}<small> kcal</small>${withDelete?`<button class="delete" data-training-delete="${t.id}" aria-label="Eliminar entrenamiento">×</button>`:""}</div></div>`}
function renderTraining(){const all=state.training||[],today=all.filter(t=>t.date===todayKey()).slice().reverse(),other=all.filter(t=>t.date!==todayKey()).slice().sort((a,b)=>b.date.localeCompare(a.date)).slice(0,12);const a=document.getElementById("trainingTodayList");if(!a)return;document.getElementById("trainingTodayCount").textContent=`${today.length} ${today.length===1?"REGISTRO":"REGISTROS"}`;a.innerHTML=today.length?today.map(t=>trainingRow(t)).join(""):'<div class="empty">Todavía no registraste entrenamientos hoy.</div>';document.getElementById("trainingHistory").innerHTML=other.length?other.map(t=>trainingRow(t)).join(""):'<div class="empty">Tus entrenamientos anteriores aparecerán acá.</div>';document.querySelectorAll("[data-training-delete]").forEach(b=>b.onclick=()=>{state.training=state.training.filter(t=>t.id!==b.dataset.trainingDelete);saveState()});updateTrainingEstimate()}
[trainingType,trainingMinutes,trainingIntensity].forEach(el=>el.addEventListener("input",updateTrainingEstimate));
saveTraining.onclick=()=>{const minutes=Math.floor(Number(trainingMinutes.value)||0),weight=latestWeight();if(minutes<1||minutes>600)return alert("Ingresá una duración válida entre 1 y 600 minutos.");if(!weight)return alert("Primero registrá tu peso en Perfil para calcular el gasto energético.");const intensityLabel=({"0.8":"Suave","1":"Moderada","1.2":"Intensa"})[trainingIntensity.value]||"Moderada";state.training=state.training||[];state.training.push({id:crypto.randomUUID?crypto.randomUUID():String(Date.now()),date:todayKey(),type:trainingType.value,name:activityNames[trainingType.value],minutes,intensity:intensityLabel,kcal:estimateTraining(),weight});trainingMinutes.value="";saveState();alert("Entrenamiento guardado.")};

function entryHTML(e){return `<div class="meal"><div class="foodicon">${e.icon||"🍽️"}</div><div class="foodinfo"><strong>${esc(e.name)}</strong><span>${esc(e.meal)} · ${e.unit?`${fmt(e.quantity)} ${e.quantity===1?esc(e.unit):esc(e.unit)+"es"} · ${fmt(e.grams)} g`:`${fmt(e.grams)} g`} · P ${fmt(e.p)} / C ${fmt(e.c)} / G ${fmt(e.f)} g</span></div><div class="kcal">${fmt(e.k)}<small>kcal</small></div><button class="delete" data-delete="${e.id}" aria-label="Eliminar">×</button></div>`}
function bindDeletes(root){root.querySelectorAll("[data-delete]").forEach(b=>b.onclick=()=>{state.entries=state.entries.filter(e=>e.id!==b.dataset.delete);saveState()})}
function renderDiary(){
 const es=todayEntries(),t=totals(es);
 document.getElementById("diaryTotal").textContent=fmt(t.k)+" kcal";
 document.getElementById("diaryProtein").textContent=fmt(t.p)+" g";
 document.getElementById("diaryCarbs").textContent=fmt(t.c)+" g";
 document.getElementById("diaryFat").textContent=fmt(t.f)+" g";
 document.getElementById("diaryCount").textContent=es.length+" "+(es.length===1?"registro":"registros");
 document.getElementById("diaryDate").textContent=new Date().toLocaleDateString("es-AR",{day:"numeric",month:"short"});
 document.getElementById("diaryMeals").innerHTML=es.length?es.slice().reverse().map(entryHTML).join(""):'<div class="diary-empty"><span>＋</span><strong>Todavía no hay comidas</strong><small>Agregá tu primera comida y empezá a registrar tu día.</small></div>';
 bindDeletes(document.getElementById("diaryMeals"));
}
function renderHistory(){const groups={};state.entries.forEach(e=>(groups[e.date]??=[]).push(e));const dates=Object.keys(groups).filter(d=>d!==todayKey()).sort().reverse().slice(0,7);document.getElementById("history").innerHTML=dates.length?dates.map(d=>{const t=totals(groups[d]);return `<div class="meal"><div class="foodicon">▤</div><div class="foodinfo"><strong>${new Date(d+"T12:00:00").toLocaleDateString("es-AR",{weekday:"short",day:"numeric",month:"short"})}</strong><span>${groups[d].length} alimentos registrados</span></div><div class="kcal">${fmt(t.k)}<small>kcal</small></div></div>`}).join(""):'<div class="empty">Tu historial aparecerá acá cuando tengas registros de otros días.</div>'}
function renderWeights(){const box=document.getElementById("weights");if(!box)return;box.innerHTML=state.weights.length?state.weights.slice(-7).reverse().map(w=>`<div class="meal"><div class="foodicon">⚖</div><div class="foodinfo"><strong>${esc(w.kg)} kg</strong><span>${new Date(w.date+"T12:00:00").toLocaleDateString("es-AR",{day:"numeric",month:"short"})}</span></div></div>`).join(""):'<div class="empty">Todavía no hay pesos registrados.</div>'}
function fillProfile(){const p=state.profile;userName.value=p.name||"";goalMode.value=p.mode||"cut";goalCalories.value=p.calories;goalProtein.value=p.protein;goalCarbs.value=p.carbs;goalFat.value=p.fat;profileAge.value=p.age||"";profileSex.value=p.sex||"male";profileHeight.value=p.height||"";profileWeight.value=p.weight||((state.weights||[]).slice(-1)[0]?.kg||"");profileActivity.value=String(p.activity||1.7);updateEnergyEstimate()}
function updateEnergyEstimate(){
 const tmp={...state.profile,age:+profileAge.value,sex:profileSex.value,height:+profileHeight.value,weight:+profileWeight.value,mode:goalMode.value};
 const e=dailyEnergy(tmp,currentSteps(),todayTrainingKcal());
 energyEstimateBox.textContent=e
  ?`Metabolismo basal: ${fmt(e.bmr)} kcal. Actividad de hoy: ${fmt(e.active)} kcal (pasos ${fmt(e.stepKcal)} + entrenamiento ${fmt(e.trainingKcal)}). Gasto total estimado: ${fmt(e.expenditure)} kcal. Objetivo sugerido: ${fmt(e.target)} kcal.`
  :"Completá edad, altura y peso para estimar tu metabolismo basal y gasto total.";
}
const energyEstimateBox=document.getElementById("energyEstimate");[profileAge,profileSex,profileHeight,profileWeight,profileActivity,goalMode].forEach(el=>el.addEventListener("input",updateEnergyEstimate));
calculateEnergy.onclick=()=>{updateEnergyEstimate();const tmp={...state.profile,age:+profileAge.value,sex:profileSex.value,height:+profileHeight.value,weight:+profileWeight.value,mode:goalMode.value};const e=dailyEnergy(tmp,currentSteps(),todayTrainingKcal());if(!e)return alert("Completá edad, altura y peso para calcular tu objetivo.");goalCalories.value=e.target;alert(`Objetivo sugerido para hoy: ${fmt(e.target)} kcal.`)}
function renderFoodResults(){const q=foodSearch.value.trim().toLocaleLowerCase("es");const filtered=foods.filter(f=>f.name.toLocaleLowerCase("es").includes(q)).slice(0,30);document.getElementById("foodResults").innerHTML=filtered.length?filtered.map((f,i)=>`<div class="foodresult"><div><strong>${f.icon} ${f.name}</strong><small>${f.k} kcal · P ${f.p} g · C ${f.c} g · G ${f.f} g por 100 g${f.unit?` · ${f.unitGrams} g por ${f.unit}`:""}</small></div><button data-food="${foods.indexOf(f)}">Elegir</button></div>`).join(""):'<div class="empty">No encontramos ese alimento. Podés cargarlo como personalizado.</div>';document.querySelectorAll("[data-food]").forEach(b=>b.onclick=()=>openFood(foods[+b.dataset.food]))}
foodSearch.addEventListener("input",renderFoodResults);
function openFood(food){selectedFood=food;modalTitle.textContent=food.name;modalFoodDesc.textContent=`Valores de referencia por 100 g: ${food.k} kcal · proteína ${food.p} g · carbohidratos ${food.c} g · grasas ${food.f} g${food.unit?`. Una unidad equivale aproximadamente a ${food.unitGrams} g.`:""}`;quantityLabel.textContent=food.unit?`Cantidad en ${food.unit}es`:`Cantidad en gramos`;grams.value=food.unit?1:100;grams.step=food.unit?1:1;mealType.value="Almuerzo";updatePreview();modal.style.display="flex"}
function selectedGrams(){if(!selectedFood)return 0;const q=Math.max(0,Number(grams.value)||0);return selectedFood.unit?q*selectedFood.unitGrams:q}
function updatePreview(){if(!selectedFood)return;const q=Math.max(0,Number(grams.value)||0),g=selectedGrams(),x=scaled(selectedFood,g);nutrientPreview.textContent=`${fmt(x.k)} kcal · Proteína ${x.p.toFixed(1)} g · Carbos ${x.c.toFixed(1)} g · Grasas ${x.f.toFixed(1)} g · ${selectedFood.unit?`${q} ${selectedFood.unit}(s) · `:""}${fmt(g)} g`}
function scaled(f,g){return {k:f.k*g/100,p:f.p*g/100,c:f.c*g/100,f:f.f*g/100}}
grams.addEventListener("input",updatePreview);closeModal.onclick=()=>modal.style.display="none";modal.onclick=e=>{if(e.target===modal)modal.style.display="none"};
confirmFood.onclick=()=>{if(!selectedFood)return;const q=Math.max(1,Number(grams.value)||(selectedFood.unit?1:100)),g=selectedGrams(),x=scaled(selectedFood,g);state.entries.push({id:crypto.randomUUID?crypto.randomUUID():String(Date.now()),date:todayKey(),name:selectedFood.name,meal:mealType.value,grams:g,quantity:selectedFood.unit?q:null,unit:selectedFood.unit||null,k:x.k,p:x.p,c:x.c,f:x.f,icon:selectedFood.icon||"🍽️"});modal.style.display="none";saveState();nav("dashboard")};
addCustom.onclick=()=>{const name=customName.value.trim();if(!name)return alert("Escribí el nombre del alimento.");const f={name,k:Math.max(0,+customKcal.value||0),p:Math.max(0,+customProtein.value||0),c:Math.max(0,+customCarbs.value||0),f:Math.max(0,+customFat.value||0),icon:"🥣"};openFood(f)};
saveGoals.onclick=()=>{const kg=+profileWeight.value||null;state.profile={...state.profile,name:userName.value.trim(),mode:goalMode.value,calories:Math.max(500,+goalCalories.value||2200),protein:Math.max(0,+goalProtein.value||0),carbs:Math.max(0,+goalCarbs.value||0),fat:Math.max(0,+goalFat.value||0),age:+profileAge.value||null,sex:profileSex.value,height:+profileHeight.value||null,weight:kg,activity:+profileActivity.value||1.7};if(kg){state.weights=state.weights||[];const last=state.weights[state.weights.length-1];if(!last||Number(last.kg)!==kg||last.date!==todayKey())state.weights.push({date:todayKey(),kg});}saveState();renderWeights();alert("Perfil y objetivos guardados.")};

exportData.onclick=()=>{const blob=new Blob([JSON.stringify(state,null,2)],{type:"application/json"}),url=URL.createObjectURL(blob),a=document.createElement("a");a.href=url;a.download="nutria-datos.json";a.click();URL.revokeObjectURL(url)};
clearData.onclick=()=>{if(confirm("¿Borrar todos los alimentos, objetivos y pesos guardados en este dispositivo? Esta acción no se puede deshacer.")){state=structuredClone(defaultState);saveState();fillProfile()}};
function esc(s){return String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]))}
if("serviceWorker" in navigator && location.protocol!=="file:"){window.addEventListener("load",()=>navigator.serviceWorker.register("./sw.js").catch(()=>{}))}
renderAll();fillProfile();
</script>
