function todayKey(){const d=new Date();return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,"0")}-${String(d.getDate()).padStart(2,"0")}`}
function fmt(n){return Math.round(n||0).toLocaleString("es-AR")}
function todayEntries(){return state.entries.filter(e=>e.date===todayKey())}
function totals(entries){return entries.reduce((a,e)=>({k:a.k+e.k,p:a.p+e.p,c:a.c+e.c,f:a.f+e.f}),{k:0,p:0,c:0,f:0})}
function nav(id){document.querySelectorAll(".view").forEach(v=>v.classList.toggle("active",v.id===id));document.querySelectorAll(".nav button").forEach(b=>b.classList.toggle("active",b.dataset.nav===id));if(id==="add")renderFoodResults();if(id==="diary")renderDiary();if(id==="profile")fillProfile();if(id==="training")renderTraining();window.scrollTo({top:0,behavior:"smooth"})}
document.querySelectorAll("[data-nav]").forEach(b=>b.addEventListener("click",()=>nav(b.dataset.nav)));
document.getElementById("profileShortcut").onclick=()=>nav("profile");
document.getElementById("today").textContent=new Date().toLocaleDateString("es-AR",{weekday:"long",day:"numeric",month:"long"});
function renderAll(){renderDashboard();renderDiary();renderHistory();renderWeights();renderTraining()}
function energyEstimate(profile=state.profile){
 const p=profile||{},w=Number(p.weight||latestWeight()),age=Number(p.age),height=Number(p.height),sex=p.sex||"male";
 if(!(w>0&&age>=14&&height>=120))return null;
 const bmr=10*w+6.25*height-5*age+(sex==="male"?5:-161);
 return {bmr};
}
function currentStepWeight(){return Number(latestWeight()||state.profile.weight||0)}
function estimateStepsKcal(steps=currentSteps(),weight=currentStepWeight()){
 return weight>0?Math.round(Math.max(0,steps)*weight*0.000375):0;
}
function todayTrainingKcal(){
 return (state.training||[]).filter(x=>x.date===todayKey()).reduce((sum,x)=>sum+(Number(x.kcal)||0),0);
}
function dailyEnergy(profile=state.profile,steps=currentSteps(),training=todayTrainingKcal()){
 const energy=energyEstimate(profile);
 if(!energy)return null;
 const stepKcal=estimateStepsKcal(steps,Number(profile.weight||latestWeight()));
 const active=stepKcal+Math.max(0,Number(training)||0);
 const expenditure=energy.bmr+active;
 const adjustment=profile.mode==="cut"?-.15:profile.mode==="bulk"?.10:0;
 return {bmr:energy.bmr,stepKcal,trainingKcal:Math.max(0,Number(training)||0),active,expenditure,target:Math.round((expenditure*(1+adjustment))/50)*50};
}
function renderDashboard(){
 const t=totals(todayEntries()),g=state.profile,energy=dailyEnergy(),baseTarget=energy?energy.target:Number(g.calories)||2200;
